<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The step that writes the drive runs in Terminal, driven by AppleScript.
	     Under the hardened runtime, an app without this is refused outright: no
	     prompt, no entry in Privacy & Security > Automation, nothing happens. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
